; Tệp cấu hình dự án Godot.

config_version=5

[application]

config/name="Anh Hùng Đất Việt"
config/description="Roguelike bắn quái cùng các vị tướng Việt Nam"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[gui]

theme/custom_font="res://assets/fonts/VT323-Regular.ttf"

[autoload]

Global="*res://scripts/autoload/global.gd"
Sfx="*res://scripts/audio/sfx.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.06, 0.05, 0.07, 1)
